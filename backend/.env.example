# ===========================================================================
#  Open VRM VTuber - backend configuration
#
#  Copy to `.env` and edit.  Every value below is optional: the defaults are
#  the ones shown, so you only have to change what you care about.
#
#  Nested keys use a double underscore:   VTUBER_<SECTION>__<FIELD>
#  Command line overrides:               python main.py --port 8765 --host 0.0.0.0
# ===========================================================================

# ------------------------------- server ------------------------------------
VTUBER_SERVER__HOST=127.0.0.1
VTUBER_SERVER__PORT=8000
# Serve the built frontend (frontend/dist) from the same port as the API.
VTUBER_SERVER__SERVE_FRONTEND=true
# Browsers only enforce CORS against the Vite dev server (port 5173); the
# backend's own port is listed as well because people open the app there.
VTUBER_SERVER__CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173","http://localhost:8000","http://127.0.0.1:8000"]
# Extra origins allowed to open the WebSocket. Same-origin is ALWAYS allowed
# (any host, any port, behind a proxy too), so this is only for a frontend
# hosted somewhere else. Use ["*"] to disable the origin check completely.
#   Example: VTUBER_SERVER__WS_ALLOWED_ORIGINS=["https://my.site"]
VTUBER_SERVER__WS_ALLOWED_ORIGINS=[]
VTUBER_SERVER__MAX_SESSIONS=8

# -------------------------------- logging ----------------------------------
# level: TRACE | DEBUG | INFO | WARNING | ERROR
VTUBER_LOG__LEVEL=INFO
# Optional second sink: one JSON object per line (log aggregators read this).
# VTUBER_LOG__JSON_FILE=logs/backend.jsonl

# ################################## LLM ####################################
# provider:  openai | ollama | echo
#   openai -> anything speaking the OpenAI /chat/completions API:
#             OpenAI, DeepSeek, Groq, Together, OpenRouter, LM Studio,
#             vLLM, llama.cpp server, Ollama (through its /v1 layer)
#   ollama -> native Ollama /api/chat endpoint
#   echo   -> OFFLINE DEMO MODE: no model at all, a canned reply is streamed
#             back so the avatar, TTS and lip-sync can be tested end to end.
#             The UI shows a warning banner while this provider is active.
VTUBER_LLM__PROVIDER=openai
VTUBER_LLM__MODEL=llama3.1:8b
VTUBER_LLM__BASE_URL=http://localhost:11434/v1
VTUBER_LLM__API_KEY=ollama
VTUBER_LLM__TEMPERATURE=0.8
VTUBER_LLM__MAX_TOKENS=512
VTUBER_LLM__MAX_CONTEXT_MESSAGES=24

# Sampling. The penalties are the cheapest cure for a small model that parrots
# the user or loops on its own last sentence; too much of either makes it
# ramble, so they are mild by default.
VTUBER_LLM__TOP_P=0.9
VTUBER_LLM__PRESENCE_PENALTY=0.35
VTUBER_LLM__FREQUENCY_PENALTY=0.35

# Reply-quality guard. Some models answer by repeating the question back at
# you. The guard only ever judges the FIRST sentence of a reply, *before* it is
# queued for speech, so a rejected attempt is never spoken: it is thrown away,
# the client is told with `llm.restart`, and one corrective regeneration runs.
#   echo_threshold   -> share of the reply's content words that may come from
#                       the user's message before it counts as parroting.
#   repeat_threshold -> same, against the previous assistant reply.
# Tune it in Settings -> Model (lower = stricter). Disable if a legit reply ever
# gets rejected: the cost of a false positive is one extra generation.
VTUBER_LLM__QUALITY_GUARD=true
VTUBER_LLM__ECHO_THRESHOLD=0.75
VTUBER_LLM__REPEAT_THRESHOLD=0.8

# Nothing listening on BASE_URL at startup? Switch this session to the offline
# "echo" brain instead of failing every turn (logged as a warning either way).
# `false` is the default and is almost always what you want: a clear "no model
# connected" banner beats silently answering with canned text - which is exactly
# the bug that made early builds look like a fixed script.
VTUBER_LLM__FALLBACK_TO_ECHO=false

# Before falling back to anything, look for a real model server on the usual
# local ports (Ollama 11434, LM Studio 1234, llama.cpp 8080, Jan 1337, vLLM
# 8000, ...) and adopt the first one that answers with at least one chat model.
# Only local ports are probed - nothing is sent anywhere else.
VTUBER_LLM__AUTO_DISCOVER=true

# Ordered backups used when the configured provider fails *before the first
# token* of a reply. Only before the first token: a reply that has already
# started is never finished by a different model, because the seam is audible.
# The offline "echo" brain is never a link here - a scripted answer is the
# failure this list exists to avoid (see FALLBACK_TO_ECHO above).
#
# The default is a single local Ollama, so a dropped hotspot or a rate-limited
# free tier turns into "answered anyway, using your local model" instead of an
# error every turn. The UI says which provider answered.
#
# Disable with an empty list:   VTUBER_LLM__FALLBACK_CHAIN=[]
# Add or reorder links as JSON:
#   VTUBER_LLM__FALLBACK_CHAIN=[{"provider":"ollama","model":"llama3.2:3b","base_url":"http://127.0.0.1:11434/v1"}]
VTUBER_LLM__FALLBACK_CHAIN=[{"provider":"ollama","model":"llama3.2:3b","base_url":"http://127.0.0.1:11434/v1"}]

# Seconds a link is skipped after it failed, so a dead endpoint costs one
# timeout per minute instead of one per turn. The primary is retried first as
# soon as the cooldown lapses.
VTUBER_LLM__FALLBACK_COOLDOWN=60

# --- pick ONE of the blocks below (they override the settings above) --------
# The easiest path of all is the UI: Settings -> Model. "Detect models on this
# machine" finds a running local server, and the ready-made list fills in the
# four values below for you (including free hosted providers).
#
# Offline demo mode - no model, no internet, everything else still works:
#   VTUBER_LLM__PROVIDER=echo
#
# Local Ollama, native endpoint (free, private, works offline):
#   VTUBER_LLM__PROVIDER=ollama
#   VTUBER_LLM__BASE_URL=http://localhost:11434
#   VTUBER_LLM__MODEL=llama3.1:8b       # ollama pull llama3.1:8b
#
# Google AI Studio / Gemini (free tier, OpenAI-compatible endpoint):
#   VTUBER_LLM__PROVIDER=openai
#   VTUBER_LLM__BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
#   VTUBER_LLM__MODEL=gemini-2.0-flash
#   VTUBER_LLM__API_KEY=...
#
# OpenAI:
#   VTUBER_LLM__PROVIDER=openai
#   VTUBER_LLM__BASE_URL=https://api.openai.com/v1
#   VTUBER_LLM__MODEL=gpt-4o-mini
#   VTUBER_LLM__API_KEY=sk-...
#
# Groq (very fast, generous free tier):
#   VTUBER_LLM__PROVIDER=openai
#   VTUBER_LLM__BASE_URL=https://api.groq.com/openai/v1
#   VTUBER_LLM__MODEL=llama-3.3-70b-versatile
#   VTUBER_LLM__API_KEY=gsk_...
#
# OpenRouter (has a free tier):
#   VTUBER_LLM__PROVIDER=openai
#   VTUBER_LLM__BASE_URL=https://openrouter.ai/api/v1
#   VTUBER_LLM__MODEL=meta-llama/llama-3.3-70b-instruct:free
#   VTUBER_LLM__API_KEY=sk-or-...
#
# DeepSeek:
#   VTUBER_LLM__PROVIDER=openai
#   VTUBER_LLM__BASE_URL=https://api.deepseek.com/v1
#   VTUBER_LLM__MODEL=deepseek-chat
#   VTUBER_LLM__API_KEY=sk-...
#
# LM Studio / llama.cpp server / vLLM on this machine:
#   VTUBER_LLM__PROVIDER=openai
#   VTUBER_LLM__BASE_URL=http://localhost:1234/v1    # or :8080, :8001 ...
#   VTUBER_LLM__MODEL=local-model
#   VTUBER_LLM__API_KEY=not-needed

# ################################## TTS ####################################
# engine: edge | openai | browser
#   edge    -> Microsoft Edge neural voices (free, needs internet, gives us
#              exact word timings -> best lip-sync)
#   openai  -> any OpenAI /v1/audio/speech compatible server (incl. local ones)
#   browser -> no server audio at all: the client speaks with the Web Speech
#              API while the backend still streams the viseme/volume timeline
#              (100% offline, useful when no TTS backend is available)
VTUBER_TTS__ENGINE=edge
VTUBER_TTS__VOICE=en-US-AriaNeural
# Speak each reply in the language it is written in by switching to a voice that
# speaks it ("edge" only - one female voice per language, see app/tts/voices.py).
# A voice that already matches the reply's language always wins, so a Bengali
# voice picked here is never overridden by a Bengali reply. Turn this off to
# always use VTUBER_TTS__VOICE, whatever the reply is written in.
VTUBER_TTS__AUTO_VOICE=true
VTUBER_TTS__RATE=+0%
VTUBER_TTS__PITCH=+0Hz
VTUBER_TTS__VOLUME=+0%
# Transport for the generated speech:  pcm_s16le (recommended) | mp3
VTUBER_TTS__FORMAT=pcm_s16le
VTUBER_TTS__SAMPLE_RATE=24000
# Audio is pushed to the client in chunks of this many milliseconds.
VTUBER_TTS__CHUNK_MS=200

# --- OpenAI compatible TTS --------------------------------------------------
# VTUBER_TTS__ENGINE=openai
# VTUBER_TTS__BASE_URL=https://api.openai.com/v1
# VTUBER_TTS__API_KEY=sk-...
# VTUBER_TTS__MODEL=tts-1
# VTUBER_TTS__VOICE=alloy

# ################################## ASR ####################################
# engine: local | openai | browser
#   local   -> faster-whisper in-process (offline; needs requirements-local.txt)
#   openai  -> any OpenAI /v1/audio/transcriptions compatible endpoint
#   browser -> the browser transcribes (Web Speech API) and sends text, so the
#              backend never sees audio and nothing extra has to be installed
#
# "browser" is the default here so a fresh clone has a working microphone with
# no optional downloads. Switch to "local" once faster-whisper is installed:
#     pip install -r requirements-local.txt
VTUBER_ASR__ENGINE=browser
VTUBER_ASR__MODEL=base.en
VTUBER_ASR__DEVICE=auto
VTUBER_ASR__COMPUTE_TYPE=int8
VTUBER_ASR__LANGUAGE=en

# --- Groq / OpenAI whisper --------------------------------------------------
# VTUBER_ASR__ENGINE=openai
# VTUBER_ASR__BASE_URL=https://api.groq.com/openai/v1
# VTUBER_ASR__MODEL=whisper-large-v3-turbo
# VTUBER_ASR__API_KEY=gsk_...

# --- transcript gate (what happens to a transcript once we have it) ---------
# Stops the avatar talking to itself. With speakers on the microphone hears the
# TTS, and a Whisper-family model transcribes near-silence as "Thank you for
# watching."; both look like a user turn. This gate drops only: silence and
# sound tags, known hallucinations, a near-copy of what the avatar just said
# (echo), and - opt-in - an exact double submit. A bare "no" or "ok" survives.
VTUBER_ASR__TRANSCRIPT__ENABLED=true
VTUBER_ASR__TRANSCRIPT__ECHO_GUARD=true
# Lower to catch a sloppier echo; raise if it eats genuine replies.
VTUBER_ASR__TRANSCRIPT__ECHO_SIMILARITY=0.72
VTUBER_ASR__TRANSCRIPT__ECHO_WINDOW=4
# People do repeat themselves when they think they were not heard, so this is
# off by default.
VTUBER_ASR__TRANSCRIPT__DEDUPE=false
VTUBER_ASR__TRANSCRIPT__MIN_CHARS=2
# A plausible phrase ("thank you") only counts as a hallucination when the audio
# it came from is shorter than this many seconds.
VTUBER_ASR__TRANSCRIPT__SHORT_UTTERANCE_SECONDS=0.9
# VTUBER_ASR__TRANSCRIPT__EXTRA_NOISE_PHRASES=["i love you too"]

# ============================ lip-sync =====================================
# mode: mouth | visemes
#   mouth   -> DEFAULT. One blendshape (`aa`), opened by the audio's RMS
#              envelope above mouth_threshold. No phoneme guessing, nothing to
#              jitter, and it reads as natural on stylised avatars.
#   visemes -> full `aa ih ou ee oh nn` mouth-shape timeline from a rule-based
#              grapheme-to-viseme step, snapped to the TTS word boundaries.
#              More expressive on a model with well authored mouth shapes.
VTUBER_LIPSYNC__MODE=mouth

# attack_ms / release_ms drive the exponential smoothing of every blendshape.
# Larger release = softer mouth. Tune with the sliders in the UI.
VTUBER_LIPSYNC__ATTACK_MS=40
VTUBER_LIPSYNC__RELEASE_MS=120
# slice_ms is the server-side RMS window used to build the `volumes` array
# (one value per window). The other three only matter in `visemes` mode.
VTUBER_LIPSYNC__VISEME_GAIN=1.0
VTUBER_LIPSYNC__AMPLITUDE_MODULATION=true
VTUBER_LIPSYNC__AMPLITUDE_FLOOR=0.45
VTUBER_LIPSYNC__SLICE_MS=20

# --- `mouth` mode only ------------------------------------------------------
# threshold: envelope level below which the mouth stays shut. Raise it in a
#            noisy room so room tone does not make the avatar chew.
# hysteresis: extra drop below the threshold needed to close again (stops
#            flutter when the level hovers on the threshold).
# scale:     how far a loud syllable opens the mouth. The envelope is
#            normalised to its own peak, so ~0.7 is conversational speech;
#            1.9 (the old default) opened the jaw to 100% on a normal vowel.
# max:       ceiling for the resulting openness, 0..1. A VRoid `aa` at 1.0 is a
#            shout, so speech is capped short of it.
# min_dwell_ms: minimum time the mouth holds a state before it may switch, so
#            syllable-rate audio cannot make it flap faster than the eye accepts.
VTUBER_LIPSYNC__MOUTH_THRESHOLD=0.12
VTUBER_LIPSYNC__MOUTH_HYSTERESIS=0.05
VTUBER_LIPSYNC__MOUTH_SCALE=0.72
VTUBER_LIPSYNC__MOUTH_MAX=0.68
VTUBER_LIPSYNC__MOUTH_MIN_DWELL_MS=60

# ============================== avatar =====================================
# A character file from backend/characters/<name>.yaml
VTUBER_AVATAR__CHARACTER=default
# Leave empty to use the bundled placeholder VRM (three-vrm sample model).
VTUBER_AVATAR__VRM_URL=
VTUBER_AVATAR__CAMERA_PRESET=bust
VTUBER_AVATAR__PIXEL_RATIO=2
VTUBER_AVATAR__ENABLE_SHADOWS=false
VTUBER_AVATAR__SHOW_STATS=false

# ################################ MEMORY ##################################
# Long-term memory: the companion remembers your name, what you say you like
# and what you have been talking about, so a later turn can pick the thread up.
#
# One JSON file. No model, no embeddings, no server: a small deterministic
# extractor (app/memory/facts.py) pulls explicit statements out of your messages
# and the file is written atomically. It is documented as human-editable - open
# it in an editor and fix anything the extractor got wrong. `null` values are
# never stored, and an unreadable file degrades to an empty profile rather than
# an error.
#
# It is ON by default: a companion that forgets you the moment you reload is
# the thing this fixed. Set ENABLED=false for a stateless conversation.
VTUBER_MEMORY__ENABLED=true
# Relative to backend/, or an absolute path.
VTUBER_MEMORY__PATH=memory/profile.json
# How many turns between rolling summaries ("earlier you were saying...").
# Each refresh is one small model call; 0 disables summarising. The offline
# brain builds its summary from tracked topics instead of calling a model.
VTUBER_MEMORY__SUMMARISE_EVERY=8
# Put the rendered profile block into the system prompt.
VTUBER_MEMORY__INJECT=true
