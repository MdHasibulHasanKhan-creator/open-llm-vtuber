# ===========================================================================
#  Frontend configuration (optional - sensible defaults are built in)
#  Copy to `.env.local`. Only VITE_* variables reach the browser.
# ===========================================================================

# WebSocket endpoint. Leave empty to derive it from the page origin, which is
# what you want both with `npm run dev` (Vite proxies /ws) and in production
# (the FastAPI server serves this app and the socket on the same port).
VITE_WS_URL=

# Avatar to load on startup, overrides whatever the backend reports.
# Empty -> use the bundled placeholder (three-vrm's sample VRM on the CDN),
# or drop your own file into public/models/ and point at /models/your.vrm
VITE_VRM_URL=

# Camera framing at start: face | bust | full
VITE_CAMERA_PRESET=bust

# Device pixel ratio cap (2 is a good balance for retina displays)
VITE_PIXEL_RATIO=2

# Backend the dev server proxies to (used by vite.config.ts)
VITE_BACKEND=http://127.0.0.1:8000
