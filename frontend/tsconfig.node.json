{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2023"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "types": ["node"],
    "isolatedModules": true,
    "strict": true,
    "skipLibCheck": true,
    "composite": true,
    /* A referenced project has to be able to emit, so it emits declarations
       only, into a throwaway directory. `tsc -b` then works with noEmit apps. */
    "declaration": true,
    "emitDeclarationOnly": true,
    "outDir": "node_modules/.tmp/tsconfig-node",
    "tsBuildInfoFile": "node_modules/.tmp/tsconfig.node.tsbuildinfo"
  },
  "include": ["vite.config.ts"]
}
